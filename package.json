	"main": "./dist/index.js",
	"scripts": {
		"dev:sync-vehicle-events": "ENVIRONMENT=development dotenv-run -f ./environments/staging/secrets/.env -- turbo run dev --filter=@tmlmobilidade/sync-vehicle-events",
